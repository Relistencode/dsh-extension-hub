{
  "name": "dsh-myrules",
  "version": "0.1.1",
  "description": "My Rules for DeepSeek Harness (DSH): edit your host-wide global instructions (~/.dsh/AGENTS.md) from the DSH Web settings page — the custom instructions apply to every chat on this machine. 在 DSH Web 设置页编辑此主机全局指令（~/.dsh/AGENTS.md）的插件——自定义指令适用于此主机上所有聊天。",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": {
      "default": "./lib/host.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./typert": {
      "default": "./lib/typert.host.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "instructions",
    "agents",
    "global-rules",
    "cordis"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Relistencode/dsh-extension-hub.git"
  }
}
